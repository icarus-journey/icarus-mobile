{
  "expo": {
    "name": "Icarus",
    "slug": "icarus-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permita que o Icarus reconheça sua fala para preencher o diário.",
        "NSMicrophoneUsageDescription": "Permita que o Icarus acesse seu microfone para transcrever sua fala no diário."
      }
    },
    "android": {
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#11091F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.fabiam.icarusmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11091F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o Icarus acesse seu microfone para transcrever sua fala no diário.",
          "speechRecognitionPermission": "Permita que o Icarus reconheça sua fala para preencher o diário.",
          "androidSpeechServicePackages": [
            "com.google.android.as"
          ]
        }
      ]
    ]
  }
}
