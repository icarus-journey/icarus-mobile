{
  "expo": {
    "name": "Icarus",
    "slug": "icarus-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#11091F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.fabiam.icarusmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11091F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher uma foto de perfil na sua galeria.",
          "cameraPermission": "Permite tirar uma foto para usar como foto de perfil."
        }
      ]
    ]
  }
}
